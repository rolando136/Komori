<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="48dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_focus_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_focus" android:textColor="@color/widget_foreground" android:textSize="22sp"
                android:fontFamily="@font/google_sans_bold" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/widget_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_pill" android:paddingHorizontal="12dp" android:paddingVertical="7dp"
            android:text="0" android:textColor="@color/widget_accent" android:textSize="13sp" android:fontFamily="@font/google_sans_medium" />
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/widget_secondary" android:textSize="12sp" android:fontFamily="@font/google_sans_regular"
        android:layout_marginTop="6dp" android:layout_marginBottom="12dp" />
    <FrameLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/widget_tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="16dp" android:text="@string/widget_empty"
            android:textColor="@color/widget_secondary" android:textSize="14sp" android:fontFamily="@font/google_sans_regular" />
    </FrameLayout>
</LinearLayout>
